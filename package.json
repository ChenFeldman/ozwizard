{
  "name": "ozwizard",
  "version": "1.0.0",
  "description": "Self-contained dependency/artifact policy & vulnerability-triage service (teaching demo).",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-data.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "mcp": "tsx mcp/server.ts",
    "dev:web": "npm run dev --prefix web",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm run dev\" \"npm run dev:web\"",
    "e2e": "playwright test",
    "participant": "bash scripts/participant-build.sh",
    "ws:before": "node scripts/ws-state.mjs before",
    "ws:after": "node scripts/ws-state.mjs after",
    "ws:reset": "node scripts/ws-state.mjs reset",
    "ws:check": "node scripts/ws-state.mjs check",
    "ws:selftest": "node scripts/ws-selftest.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
