diff --git a/test/taskPool.test.ts b/test/taskPool.test.ts
new file mode 100644
index 0000000..35d0a8d
--- /dev/null
+++ b/test/taskPool.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'vitest';
+import { DEFAULT_POOL_SIZE, runPooled } from '../src/core/taskPool.js';
+
+const wait = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
+
+describe('runPooled', () => {
+  it('keeps results positional even when tasks finish out of order', async () => {
+    const out = await runPooled([30, 5, 20, 1], 2, async (ms) => {
+      await wait(ms);
+      return ms;
+    });
+    expect(out).toEqual([30, 5, 20, 1]);
+  });
+
+  it('caps how many tasks run at the same time', async () => {
+    let open = 0;
+    let peak = 0;
+    await runPooled([1, 2, 3, 4, 5, 6], 3, async (n) => {
+      open += 1;
+      peak = Math.max(peak, open);
+      await wait(2);
+      open -= 1;
+      return n;
+    });
+    expect(peak).toBe(3);
+  });
+
+  it('treats a non-positive size as unbounded', async () => {
+    let open = 0;
+    let peak = 0;
+    await runPooled([1, 2, 3, 4], 0, async (n) => {
+      open += 1;
+      peak = Math.max(peak, open);
+      await wait(2);
+      open -= 1;
+      return n;
+    });
+    expect(peak).toBe(4);
+  });
+
+  it('exposes a sane default pool size', () => {
+    expect(DEFAULT_POOL_SIZE).toBeGreaterThan(1);
+  });
+});
