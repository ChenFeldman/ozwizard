diff --git a/src/core/taskPool.ts b/src/core/taskPool.ts
new file mode 100644
index 0000000..41cf1a0
--- /dev/null
+++ b/src/core/taskPool.ts
@@ -0,0 +1,48 @@
+/**
+ * A tiny worker pool for the live scan.
+ *
+ * The live scan does one upstream advisory lookup per resolved dependency. Doing
+ * those one at a time makes wall-clock scale linearly with dependency count, which
+ * is what OZ-102 is about. This runs a bounded number of them at the same time.
+ *
+ * Deliberately dependency-free and self-contained so the scanner does not grow a
+ * dependency on anything outside `src/core/`.
+ */
+
+/** How many lookups the pool keeps open at once when the caller doesn't say. */
+export const DEFAULT_POOL_SIZE = 8;
+
+/**
+ * Run `task` for every entry of `items`, keeping at most `size` of them running at
+ * the same time. Results come back positionally, so `out[i]` is the result for
+ * `items[i]` no matter what order the tasks finished in.
+ *
+ * A `size` of zero or less means "no ceiling" — everything is started at once.
+ */
+export async function runPooled<T, R>(
+  items: readonly T[],
+  size: number,
+  task: (item: T, index: number) => Promise<R>
+): Promise<R[]> {
+  const out = new Array<R>(items.length);
+  if (items.length === 0) return out;
+
+  const width = size > 0 ? Math.min(size, items.length) : items.length;
+  let cursor = 0;
+
+  const runners: Promise<void>[] = [];
+  for (let w = 0; w < width; w++) {
+    runners.push(
+      (async () => {
+        for (;;) {
+          const index = cursor++;
+          if (index >= items.length) return;
+          out[index] = await task(items[index]!, index);
+        }
+      })()
+    );
+  }
+
+  await Promise.all(runners);
+  return out;
+}
